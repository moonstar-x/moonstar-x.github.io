{
  "extends": "@moonstar-x/tsconfig/react",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@core/*": ["src/core/*"],
      "@data/*": ["data/*"],
      "@styles/*": ["src/styles/*"],
    },
    "outDir": "build-ts",
    "types": ["node"],

    "noEmit": true,
    "moduleResolution": "node",
    "incremental": true,
    "plugins": [{
      "name": "next"
    }]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "build/dev/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "build-ts",
  ]
}